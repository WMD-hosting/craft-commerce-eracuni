{
  "name": "wmd/craft-commerce-eracuni",
  "description": "Turn Craft Commerce orders into e-racuni.hr invoices: fiscalisation, KPD, AS4 and FINA delivery.",
  "type": "craft-plugin",
  "license": "proprietary",
  "keywords": ["craft", "commerce", "eracuni", "invoice", "fiskalizacija", "croatia"],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.3.0",
    "craftcms/commerce": "^5.0.0",
    "verbb/base": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": { "wmd\\commerceeracuni\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "wmd\\commerceeracuni\\tests\\": "tests/" }
  },
  "extra": {
    "handle": "commerce-eracuni",
    "name": "e-Računi for Commerce",
    "developer": "WMD",
    "developerUrl": "https://wmd.hr",
    "documentationUrl": "https://github.com/WMD-hosting/craft-commerce-eracuni",
    "class": "wmd\\commerceeracuni\\Plugin"
  },
  "scripts": {
    "test": "phpunit",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": { "php": "8.2" },
    "allow-plugins": { "yiisoft/yii2-composer": true, "craftcms/plugin-installer": true }
  }
}
