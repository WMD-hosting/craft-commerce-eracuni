{% set d = document %}
<div class="meta read-only eracuni-panel">
    <h3 class="heading">{{ 'e-Računi'|t('commerce-eracuni') }}</h3>
    {% if d %}
        <div class="data"><dt>{{ 'Status'|t('commerce-eracuni') }}</dt><dd><span class="status {{ d.status == 'sent' ? 'green' : (d.status == 'failed' ? 'red' : 'orange') }}"></span>{{ d.status }}</dd></div>
        {% if d.number %}<div class="data"><dt>{{ 'Number'|t('commerce-eracuni') }}</dt><dd>{{ d.number }}</dd></div>{% endif %}
        {% if d.treatment %}<div class="data"><dt>{{ 'Treatment'|t('commerce-eracuni') }}</dt><dd>{{ d.treatment }} · {{ d.method }}{% if d.fiscalised %} · F1{% endif %}</dd></div>{% endif %}
        {% if d.deliveryChannel %}<div class="data"><dt>{{ 'Delivery'|t('commerce-eracuni') }}</dt><dd>{{ d.deliveryChannel|upper }}: {{ d.deliveryBucket }}</dd></div>{% endif %}
        {% if d.pdfUrl %}<div class="data"><dt>PDF</dt><dd><a href="{{ d.pdfUrl }}" target="_blank">{{ 'Open PDF'|t('commerce-eracuni') }}</a></dd></div>{% endif %}
        {% if d.error %}<div class="data"><dt>{{ 'Notes'|t('commerce-eracuni') }}</dt><dd class="error" style="white-space:pre-wrap">{{ d.error }}</dd></div>{% endif %}
    {% else %}
        <p class="light">{{ 'Not sent yet.'|t('commerce-eracuni') }}</p>
    {% endif %}
    {# This panel renders inside Commerce's #main-form, which the order page submits on save: no
       <form> and no named inputs here, or they would ride along with every order save. #}
    {% if d and d.outcomeUnknown %}
    <p class="warning" style="margin:8px 0 0">{{ 'Check in e-računi first: the last send may already have created this invoice.'|t('commerce-eracuni') }}</p>
    {% endif %}
    <div class="buttons" style="margin-top:8px">
        {% if d and d.outcomeUnknown %}
        {% if d.canVerifyNotBooked %}
        <button type="button" class="btn small" data-eracuni-send data-verified-attempts="{{ d.attempts }}" data-confirm="{{ 'Only continue if e-računi holds no invoice for this order. Sending again otherwise creates a second fiscal invoice.'|t('commerce-eracuni')|e('html_attr') }}">{{ 'Verified not booked, send again'|t('commerce-eracuni') }}</button>
        {% endif %}
        {% elseif not d or d.status != 'sent' %}
        <button type="button" class="btn small submit" data-eracuni-send>{{ 'Send to e-računi'|t('commerce-eracuni') }}</button>
        {% endif %}
        <button type="button" class="btn small" id="eracuni-preview">{{ 'Preview payload'|t('commerce-eracuni') }}</button>
    </div>
    <pre id="eracuni-preview-out" class="hidden" style="max-height:400px;overflow:auto;font-size:11px"></pre>
</div>
{% js %}
document.querySelectorAll('[data-eracuni-send]').forEach(function (btn) {
    btn.addEventListener('click', function () {
        if (btn.dataset.confirm && !window.confirm(btn.dataset.confirm)) {
            return;
        }
        const data = { orderId: {{ order.id }} };
        if (btn.dataset.verifiedAttempts) {
            data.verifiedAttempts = btn.dataset.verifiedAttempts;
        }
        btn.disabled = true;
        Craft.sendActionRequest('POST', 'commerce-eracuni/documents/send', { data: data })
            .then(function (r) { Craft.cp.displayNotice(r.data.message); window.location.reload(); })
            .catch(function (e) { btn.disabled = false; Craft.cp.displayError(e.response && e.response.data && e.response.data.message || e.message); });
    });
});
document.getElementById('eracuni-preview').addEventListener('click', function () {
    const out = document.getElementById('eracuni-preview-out');
    out.classList.remove('hidden'); out.textContent = '…';
    Craft.sendActionRequest('POST', 'commerce-eracuni/documents/preview', { data: { orderId: {{ order.id }} } })
        .then(r => { out.textContent = r.data.success ? JSON.stringify(r.data, null, 2) : r.data.error; })
        .catch(e => { out.textContent = e.message; });
});
{% endjs %}
